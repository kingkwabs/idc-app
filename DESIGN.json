{
  "schemaVersion": "1.0.0",
  "name": "IDC Energy Operations Hub",
  "version": "1.0.0",
  "source": "idc-operations-hub/src/styles/globals.css",
  "assets": {
    "logo": "idc-operations-hub/public/idce_logo.avif"
  },
  "principles": [
    "Operational clarity first",
    "Earn trust through explicit state",
    "IDC Energy is the accent, not the wallpaper",
    "Familiar patterns move faster",
    "Build for change"
  ],
  "tokens": {
    "color": {
      "brand": {
        "charcoal": "oklch(0.275 0.003 345.5)",
        "paper": "oklch(0.973 0.007 88.6)",
        "red": "oklch(0.625 0.217 28.6)",
        "amber": "oklch(0.786 0.14 70)"
      },
      "semantic": {
        "background": "var(--idc-paper)",
        "foreground": "var(--idc-charcoal)",
        "card": "oklch(0.986 0.006 84.6)",
        "primary": "oklch(0.502 0.18 23.9)",
        "primaryHover": "oklch(0.455 0.165 23.5)",
        "secondary": "oklch(0.948 0.012 79.8)",
        "muted": "oklch(0.921 0.014 78.3)",
        "border": "oklch(0.808 0.018 76.1)",
        "success": "oklch(0.505 0.072 157.1)",
        "warning": "var(--idc-amber)",
        "info": "oklch(0.477 0.073 235.5)",
        "destructive": "oklch(0.479 0.172 23.6)"
      }
    },
    "typography": {
      "family": "IBM Plex Sans Variable, IBM Plex Sans, sans-serif",
      "baseSize": "16px",
      "weights": {
        "normal": 400,
        "medium": 500,
        "semibold": 600
      },
      "numericVariant": "tabular-nums lining-nums"
    },
    "radius": {
      "base": "0.625rem",
      "small": "calc(var(--radius) - 4px)",
      "medium": "calc(var(--radius) - 2px)",
      "large": "var(--radius)"
    },
    "spacing": {
      "baseUnit": "4px",
      "controlHeight": ["36px", "40px"],
      "fieldGap": ["12px", "16px"],
      "sectionGap": ["24px", "32px"]
    },
    "shadow": {
      "control": "0 1px 2px oklch(0.275 0.003 345.5 / 0.08)",
      "card": "0 1px 2px oklch(0.275 0.003 345.5 / 0.05), 0 8px 24px oklch(0.275 0.003 345.5 / 0.04)",
      "popover": "0 12px 32px oklch(0.275 0.003 345.5 / 0.14), 0 2px 6px oklch(0.275 0.003 345.5 / 0.08)",
      "dialog": "0 24px 64px oklch(0.275 0.003 345.5 / 0.2), 0 4px 12px oklch(0.275 0.003 345.5 / 0.1)"
    },
    "motion": {
      "easing": "cubic-bezier(0.23, 1, 0.32, 1)",
      "durationMs": {
        "fast": 120,
        "standard": 180,
        "slow": 240
      },
      "reducedMotion": true
    },
    "breakpointChecks": ["375px", "768px", "1280px", "1440px"]
  },
  "statusLanguage": {
    "critical": "red",
    "attention": "amber",
    "complete": "green",
    "informational": "blue",
    "requiresTextLabel": true
  },
  "prohibitedPatterns": [
    "glassmorphism",
    "decorative background motion",
    "transition-all",
    "one-off component hex colors",
    "color-only status",
    "unconfirmed external-system success"
  ],
  "accessibility": {
    "target": "WCAG 2.2 AA",
    "minimumTouchTarget": "40px",
    "keyboardRequired": true,
    "visibleFocusRequired": true,
    "semanticLabelsRequired": true
  }
}
