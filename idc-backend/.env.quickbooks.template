# QuickBooks OAuth Configuration
# Copy these to your .env file and fill in your actual values

# Get these from https://developer.intuit.com/ -> Your App -> Keys & OAuth
QB_CLIENT_ID=your_quickbooks_client_id_here
QB_CLIENT_SECRET=your_quickbooks_client_secret_here

# Your backend callback URL (must match what's in QuickBooks Developer Portal)
# Production example: https://idc-app.onrender.com/quickbooks/callback
# Local testing: http://localhost:5001/quickbooks/callback
QB_REDIRECT_URI=https://your-backend-url.onrender.com/quickbooks/callback

# Environment: "sandbox" for testing, "production" for live QuickBooks data
QB_ENVIRONMENT=production

# Instructions:
# 1. Create a QuickBooks app at https://developer.intuit.com/
# 2. Get your Client ID and Secret from the Keys & OAuth tab
# 3. Add your redirect URI to the QuickBooks app settings
# 4. Copy these values to your .env file (locally) AND Render environment variables (production)
# 5. Run: python scripts/migrate_quickbooks.py
# 6. Test: python test_quickbooks.py check-connection
